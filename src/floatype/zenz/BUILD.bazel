load(
    "//:build_defs.bzl",
    "mozc_cc_binary",
    "mozc_cc_library",
    "mozc_cc_test",
    "mozc_select",
)

package(default_visibility = ["//visibility:private"])

mozc_cc_library(
    name = "scorer_client",
    srcs = ["scorer_client.cc"],
    hdrs = ["scorer_client.h"],
    visibility = [
        "//floatype/eval:__pkg__",
        "//session:__pkg__",
    ],
    deps = [
        "//base:clock",
        "//floatype/scorer:protocol",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/synchronization",
        "@com_google_absl//absl/time",
    ],
)

mozc_cc_binary(
    name = "fake_scorer",
    testonly = True,
    srcs = ["fake_scorer_main.cc"],
    visibility = ["//session:__pkg__"],
    deps = ["//floatype/scorer:protocol"],
)

mozc_cc_test(
    name = "scorer_client_test",
    srcs = ["scorer_client_test.cc"],
    data = [":fake_scorer"],
    deps = [
        ":scorer_client",
        "//base:clock",
        "//base:clock_mock",
        "//base:file_util",
        "//base:system_util",
        "//floatype/scorer:protocol",
        "//testing:gunit",
        "//testing:gunit_main",
        "//testing:mozctest",
        "@com_google_absl//absl/time",
    ],
)

mozc_cc_library(
    name = "letter_reading",
    srcs = ["letter_reading.cc"],
    hdrs = ["letter_reading.h"],
    deps = [
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

mozc_cc_test(
    name = "letter_reading_test",
    srcs = ["letter_reading_test.cc"],
    deps = [
        ":letter_reading",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "number_reading",
    srcs = ["number_reading.cc"],
    hdrs = ["number_reading.h"],
    deps = ["@com_google_absl//absl/strings"],
)

mozc_cc_test(
    name = "number_reading_test",
    srcs = ["number_reading_test.cc"],
    deps = [
        ":number_reading",
        "//testing:gunit_main",
    ],
)

mozc_cc_library(
    name = "zenz_corrector",
    srcs = ["zenz_corrector.cc"],
    hdrs = ["zenz_corrector.h"],
    # IsSecureEventInputEnabled
    linkopts = mozc_select(macos = [
        "-framework",
        "Carbon",
    ]),
    visibility = [
        "//floatype/eval:__pkg__",
        "//server:__pkg__",
        "//session:__pkg__",
    ],
    deps = [
        ":letter_reading",
        ":number_reading",
        ":scorer_client",
        ":zenz_memory",
        "//base:clock",
        "//base:file_util",
        "//base:number_util",
        "//base:system_util",
        "//base:util",
        "//base/strings:japanese",
        "//base/strings:unicode",
        "//config:character_form_manager",
        "//converter:attribute",
        "//converter:segments",
        "//floatype/scorer:protocol",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
        "@com_google_absl//absl/types:span",
    ],
)

mozc_cc_test(
    name = "zenz_corrector_test",
    srcs = ["zenz_corrector_test.cc"],
    data = [":fake_scorer"],
    deps = [
        ":scorer_client",
        ":zenz_corrector",
        ":zenz_memory",
        "//base:clock",
        "//base:clock_mock",
        "//base:file_util",
        "//base:system_util",
        "//config:character_form_manager",
        "//converter:attribute",
        "//converter:segments",
        "//protocol:config_cc_proto",
        "//testing:gunit",
        "//testing:gunit_main",
        "//testing:mozctest",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)

mozc_cc_library(
    name = "zenz_memory",
    srcs = ["zenz_memory.cc"],
    hdrs = ["zenz_memory.h"],
    visibility = ["//session:__pkg__"],
    deps = [
        "//base:file_util",
        "//base:system_util",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_test(
    name = "zenz_memory_test",
    srcs = ["zenz_memory_test.cc"],
    deps = [
        ":zenz_memory",
        "//base:file_util",
        "//base:system_util",
        "//testing:gunit_main",
        "//testing:mozctest",
        "@com_google_absl//absl/strings",
    ],
)
