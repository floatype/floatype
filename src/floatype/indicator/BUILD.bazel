load("//:build_defs.bzl", "mozc_cc_library", "mozc_cc_test")

package(default_visibility = ["//visibility:private"])

mozc_cc_library(
    name = "indicator_layout",
    srcs = ["indicator_layout.cc"],
    hdrs = ["indicator_layout.h"],
    visibility = [
        "//gui/config_dialog:__pkg__",
        "//renderer:__pkg__",
    ],
    deps = [
        "//protocol:commands_cc_proto",
        "//protocol:config_cc_proto",
    ],
)

mozc_cc_test(
    name = "indicator_layout_test",
    srcs = ["indicator_layout_test.cc"],
    deps = [
        ":indicator_layout",
        "//protocol:commands_cc_proto",
        "//protocol:config_cc_proto",
        "//testing:gunit_main",
    ],
)
