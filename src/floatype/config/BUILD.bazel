load("//:build_defs.bzl", "mozc_cc_library", "mozc_cc_test")

package(default_visibility = ["//visibility:private"])

exports_files(["config.example.txtpb"])

mozc_cc_library(
    name = "text_config",
    srcs = ["text_config.cc"],
    hdrs = ["text_config.h"],
    visibility = [
        "//config:__pkg__",
        "//mac:__pkg__",
        "//server:__pkg__",
        "//session:__pkg__",
    ],
    deps = [
        "//base:clock",
        "//base:file_util",
        "//base/protobuf:text_format",
        "//protocol:config_cc_proto",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/synchronization",
        "@com_google_absl//absl/time",
        "@com_google_absl//absl/types:span",
    ],
)

mozc_cc_test(
    name = "text_config_test",
    srcs = ["text_config_test.cc"],
    data = ["config.example.txtpb"],
    deps = [
        ":text_config",
        "//base:clock",
        "//base:clock_mock",
        "//base:file_util",
        "//base/protobuf:text_format",
        "//base:system_util",
        "//protocol:config_cc_proto",
        "//testing:gunit_main",
        "//testing:mozctest",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
    ],
)

mozc_cc_test(
    name = "config_handler_overlay_test",
    srcs = ["config_handler_overlay_test.cc"],
    deps = [
        ":text_config",
        "//base:file_util",
        "//base:system_util",
        "//config:config_handler",
        "//protocol:config_cc_proto",
        "//testing:gunit_main",
        "//testing:mozctest",
    ],
)
