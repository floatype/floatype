load("//:build_defs.bzl", "mozc_cc_library", "mozc_cc_test")

package(default_visibility = ["//visibility:private"])

mozc_cc_library(
    name = "window_look",
    srcs = ["window_look.cc"],
    hdrs = ["window_look.h"],
    visibility = [
        "//floatype/settings:__pkg__",
        "//gui/config_dialog:__pkg__",
        "//renderer:__subpackages__",
    ],
    deps = [
        "//protocol:config_cc_proto",
        "//protocol:renderer_cc_proto",
        "//renderer:renderer_style_handler",
    ],
)

mozc_cc_test(
    name = "window_look_test",
    srcs = ["window_look_test.cc"],
    deps = [
        ":window_look",
        "//protocol:config_cc_proto",
        "//protocol:renderer_cc_proto",
        "//renderer:renderer_style_handler",
        "//testing:gunit_main",
    ],
)
