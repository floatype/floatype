load("//:build_defs.bzl", "mozc_cc_library", "mozc_cc_test")
load("//build_tools:embed_file.bzl", "mozc_embed_file")

package(default_visibility = ["//visibility:private"])

exports_files(["SCOWL-Copyright"])

mozc_embed_file(
    name = "english_words_data",
    srcs = ["english_words.txt"],
    out = "english_words.inc",
    as_string_view = True,
    var_name = "kEnglishWords",
)

mozc_cc_library(
    name = "english_words",
    srcs = [
        "english_words.cc",
        ":english_words_data",
    ],
    hdrs = ["english_words.h"],
    visibility = [
        "//floatype/eval:__pkg__",
        "//session:__pkg__",
    ],
    deps = [
        "//base/strings:unicode",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_test(
    name = "english_words_test",
    srcs = ["english_words_test.cc"],
    deps = [
        ":english_words",
        "//testing:gunit_main",
    ],
)
