load("//:build_defs.bzl", "mozc_cc_library", "mozc_cc_test")
load("//build_tools:embed_file.bzl", "mozc_embed_file")

package(default_visibility = ["//visibility:private"])

exports_files(["SCOWL-Copyright"])

mozc_embed_file(
    name = "english_words_data",
    srcs = ["english_words.txt"],
    out = "english_words.inc",
    as_string_view = True,
    var_name = "kEnglishWords",
)

mozc_embed_file(
    name = "preset_words_data",
    srcs = ["preset_words.txt"],
    out = "preset_words.inc",
    as_string_view = True,
    var_name = "kPresetWords",
)

mozc_cc_library(
    name = "user_words",
    srcs = [
        "user_words.cc",
        ":preset_words_data",
    ],
    hdrs = ["user_words.h"],
    visibility = [
        "//floatype/settings:__pkg__",
        "//gui/config_dialog:__pkg__",
    ],
    deps = [
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/strings",
    ],
)

mozc_cc_library(
    name = "english_words",
    srcs = [
        "english_words.cc",
        ":english_words_data",
    ],
    hdrs = ["english_words.h"],
    visibility = [
        "//floatype/eval:__pkg__",
        "//session:__pkg__",
    ],
    deps = [
        ":user_words",
        "//base:file_util",
        "//base:util",
        "//base/strings:unicode",
        "//floatype/config:settings_file",
        "@com_google_absl//absl/base:no_destructor",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/synchronization",
        "@com_google_absl//absl/types:span",
    ],
)

mozc_cc_test(
    name = "english_words_test",
    srcs = ["english_words_test.cc"],
    data = ["preset_words.txt"],
    deps = [
        ":english_words",
        ":user_words",
        "//base:clock",
        "//base:clock_mock",
        "//base:file_util",
        "//base/file:temp_dir",
        "//floatype/config:settings_file",
        "//testing:gunit_main",
        "//testing:mozctest",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
    ],
)
