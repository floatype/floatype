load("//:build_defs.bzl", "mozc_cc_binary")

package(default_visibility = ["//visibility:private"])

# Replays Space conversions with the real engine and scorer. Driven by
# ajimee.py --engine replay.
mozc_cc_binary(
    name = "replay_main",
    testonly = True,
    srcs = ["replay_main.cc"],
    deps = [
        "//base:init_mozc",
        "//base:system_util",
        "//base:util",
        "//base/file:temp_dir",
        "//base/strings:japanese",
        "//base/strings:unicode",
        "//config:config_handler",
        "//engine",
        "//engine:eval_engine_factory",
        "//floatype/zenz:scorer_client",
        "//floatype/zenz:zenz_corrector",
        "//protocol:commands_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/time",
    ],
)
